{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ColorTheme",
  "description": "A color theme family: one palette per appearance.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Editor hint: URL or path of the JSON Schema. Ignored by the app.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "id": {
      "description": "Unique id, persisted in settings. The same id as a built-in replaces it.",
      "type": "string"
    },
    "label": {
      "description": "Name shown in Settings > Appearance.",
      "type": "string"
    },
    "dark": {
      "description": "Palette used in dark mode.",
      "$ref": "#/$defs/Palette"
    },
    "light": {
      "description": "Palette used in light mode.",
      "$ref": "#/$defs/Palette"
    }
  },
  "required": [
    "id",
    "label",
    "dark",
    "light"
  ],
  "$defs": {
    "Palette": {
      "description": "Source colors of one theme variant.",
      "type": "object",
      "properties": {
        "bg": {
          "description": "Diff plane (the deepest surface in dark variants).",
          "$ref": "#/$defs/Hex"
        },
        "surface": {
          "description": "Toolbar / sidebar.",
          "$ref": "#/$defs/Hex"
        },
        "card": {
          "description": "Cards and panels.",
          "$ref": "#/$defs/Hex"
        },
        "overlay": {
          "description": "Popovers and menus.",
          "$ref": "#/$defs/Hex"
        },
        "raised": {
          "description": "Opaque chips and pills.",
          "$ref": "#/$defs/Hex"
        },
        "text": {
          "description": "Primary text.",
          "$ref": "#/$defs/Hex"
        },
        "muted": {
          "description": "Secondary text.",
          "$ref": "#/$defs/Hex"
        },
        "faint": {
          "description": "Tertiary text, gutters, disabled.",
          "$ref": "#/$defs/Hex"
        },
        "accent": {
          "description": "Accent color: links, selection, focus.",
          "$ref": "#/$defs/Hex"
        },
        "accent_strong": {
          "description": "Stronger accent for pressed or emphasized states.",
          "$ref": "#/$defs/Hex"
        },
        "danger": {
          "description": "Errors and deleted lines.",
          "$ref": "#/$defs/Hex"
        },
        "warning": {
          "description": "Warnings and modified files.",
          "$ref": "#/$defs/Hex"
        },
        "success": {
          "description": "Success and added lines.",
          "$ref": "#/$defs/Hex"
        },
        "on_accent": {
          "description": "Text on accent fills.",
          "$ref": "#/$defs/Hex"
        },
        "diff_add_bg": {
          "description": "Optional diff colors; each defaults to a value derived from the colors above.\nAdded line background.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_del_bg": {
          "description": "Deleted line background.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_hunk_bg": {
          "description": "Hunk header background.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_add_emph": {
          "description": "Word-level emphasis inside added lines.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_del_emph": {
          "description": "Word-level emphasis inside deleted lines.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_add_gutter_bg": {
          "description": "Line-number cell of added lines. Defaults to `diff_add_bg`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_del_gutter_bg": {
          "description": "Line-number cell of deleted lines. Defaults to `diff_del_bg`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_hunk_gutter_bg": {
          "description": "Gutter of hunk headers (expand buttons) and the hunk handle column.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_gutter_bg": {
          "description": "Line-number cell of unchanged lines.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_empty_bg": {
          "description": "Split view placeholder opposite an added or deleted line.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_gutter": {
          "description": "Line number text. Defaults to `faint`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_types": {
          "description": "Pill colors of conventional commit types (`feat`, `fix`, ...), merged over the defaults.\nTypes without a color get a neutral pill.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Hex"
          }
        },
        "opacity": {
          "description": "Opacity of each surface when the window background is Transparent or Blurred.",
          "$ref": "#/$defs/SurfaceOpacity"
        }
      },
      "required": [
        "bg",
        "surface",
        "card",
        "overlay",
        "raised",
        "text",
        "muted",
        "faint",
        "accent",
        "accent_strong",
        "danger",
        "warning",
        "success",
        "on_accent"
      ]
    },
    "Hex": {
      "description": "A `#rrggbb` color from JSON.",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "SurfaceOpacity": {
      "description": "Opacity (0 to 1) of the surfaces painted with the palette colors of the same name.\nIgnored when the window background is Opaque. A missing key takes its default.",
      "type": "object",
      "properties": {
        "bg": {
          "description": "Diff plane, welcome screen and CI page. Default 0.8.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.800000011920929
        },
        "surface": {
          "description": "Toolbar and sidebar. Default 0.7.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.699999988079071
        },
        "card": {
          "description": "Cards and panels. Default 0.85.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.8500000238418579
        },
        "overlay": {
          "description": "Popovers, menus, dialogs and tooltips. Default 0.95.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.949999988079071
        },
        "raised": {
          "description": "Opaque chips and pills. Default 0.9.",
          "type": "number",
          "format": "float",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.8999999761581421
        }
      }
    }
  }
}
